# Fore Coffee API secret key (previously hardcoded — now required via env)
FORE_SECRET_KEY=your_secret_key_here

# Fore Coffee app version sent in API headers
FORE_VERSION=6.6.0

# Default security PIN for new accounts
DEFAULT_PIN=123456

# (Optional) 64-char hex key for encrypting tokens in accounts.json.
# If omitted, a random key is generated each run (existing encrypted data
# will not be decryptable across restarts without a stable key).
ENCRYPTION_KEY=
